    { "type": "wokwi-led", "id": "led_yellow", "top": 100, "left": 300, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_red", "top": 140, "left": 300, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led_compressor", "top": 180, "left": 300, "attrs": { "color": "blue" } },
