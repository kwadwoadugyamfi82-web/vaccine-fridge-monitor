    ["dht:VCC", "esp:3V3", "red", []],
    ["dht:GND", "esp:GND.1", "black", []],
    ["dht:SDA", "esp:18", "green", []],
    ["dht:SDA", "r_pullup:1", "green", []],
    ["r_pullup:2", "esp:3V3", "red", []],

    ["btn:1.l", "esp:5", "yellow", []],
